{
  "name": "@mock-tools/api",
  "version": "0.2.0",
  "description": "In-process mock API: resources + HTTP routes, middleware, health, SSE/WS.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azarov-serge/mock-tools.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/azarov-serge/mock-tools/tree/main/packages/api",
  "bugs": {
    "url": "https://github.com/azarov-serge/mock-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "5.1.6",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mock",
    "api",
    "resources",
    "routes",
    "typescript"
  ]
}
